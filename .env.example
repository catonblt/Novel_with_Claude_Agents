# Novel Writer - API Configuration
#
# To use this file:
# 1. Copy this file to ~/.novel_writer/.env
#    (On Windows: C:\Users\YourName\.novel_writer\.env)
# 2. Replace YOUR_API_KEY_HERE with your actual Anthropic API key
# 3. Save the file
# 4. Restart the Novel Writer application
#
# Get your API key from: https://console.anthropic.com/settings/keys
#
# Your API key should look like: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
